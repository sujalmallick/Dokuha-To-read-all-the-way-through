CREATE TABLE categories (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    sort INTEGER NOT NULL DEFAULT 0,
    flags INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE mangas_categories (
    manga_id INTEGER NOT NULL,
    category_id INTEGER NOT NULL,
    PRIMARY KEY (manga_id, category_id),
    FOREIGN KEY(manga_id) REFERENCES mangas(id) ON DELETE CASCADE,
    FOREIGN KEY(category_id) REFERENCES categories(id) ON DELETE CASCADE
);

getCategories:
SELECT *
FROM categories
ORDER BY sort ASC;

insertCategory:
INSERT OR REPLACE INTO categories (id, name, sort, flags)
VALUES (:id, :name, :sort, :flags);

deleteCategory:
DELETE FROM categories
WHERE id = :id;

insertMangaCategory:
INSERT OR REPLACE INTO mangas_categories (manga_id, category_id)
VALUES (:mangaId, :categoryId);

deleteMangaCategories:
DELETE FROM mangas_categories
WHERE manga_id = :mangaId;
