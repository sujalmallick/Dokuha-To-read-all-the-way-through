CREATE TABLE mangas (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    source_id INTEGER NOT NULL,
    url TEXT NOT NULL UNIQUE,
    title TEXT NOT NULL,
    artist TEXT,
    author TEXT,
    description TEXT,
    genres TEXT,
    status TEXT NOT NULL DEFAULT 'UNKNOWN',
    thumbnail_url TEXT,
    favorite INTEGER NOT NULL DEFAULT 0,
    last_update INTEGER NOT NULL DEFAULT 0,
    next_update INTEGER NOT NULL DEFAULT 0,
    initialized INTEGER NOT NULL DEFAULT 0,
    viewer_flags INTEGER NOT NULL DEFAULT 0,
    chapter_flags INTEGER NOT NULL DEFAULT 0,
    cover_last_modified INTEGER NOT NULL DEFAULT 0,
    date_added INTEGER NOT NULL DEFAULT 0,
    is_novel INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX mangas_url_idx ON mangas(url);
CREATE INDEX mangas_favorite_idx ON mangas(favorite);

getLibrary:
SELECT *
FROM mangas
WHERE favorite = 1
ORDER BY title ASC;

getLibraryByCategory:
SELECT m.*
FROM mangas m
JOIN mangas_categories mc ON m.id = mc.manga_id
WHERE m.favorite = 1 AND mc.category_id = :categoryId
ORDER BY m.title ASC;

getMangaByUrl:
SELECT *
FROM mangas
WHERE url = :url
LIMIT 1;

getMangaById:
SELECT *
FROM mangas
WHERE id = :id
LIMIT 1;

insertOrUpdateManga:
INSERT OR REPLACE INTO mangas (
    id, source_id, url, title, artist, author, description,
    genres, status, thumbnail_url, favorite, last_update,
    next_update, initialized, viewer_flags, chapter_flags,
    cover_last_modified, date_added, is_novel
) VALUES (
    :id, :sourceId, :url, :title, :artist, :author, :description,
    :genres, :status, :thumbnailUrl, :favorite, :lastUpdate,
    :nextUpdate, :initialized, :viewerFlags, :chapterFlags,
    :coverLastModified, :dateAdded, :isNovel
);

setFavorite:
UPDATE mangas
SET favorite = :favorite, date_added = :dateAdded
WHERE url = :url;

deleteByUrl:
DELETE FROM mangas
WHERE url = :url;
