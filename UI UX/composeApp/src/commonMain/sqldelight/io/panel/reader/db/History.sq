CREATE TABLE history (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    chapter_id INTEGER NOT NULL UNIQUE,
    read_at INTEGER NOT NULL,
    time_read INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(chapter_id) REFERENCES chapters(id) ON DELETE CASCADE
);

CREATE INDEX history_chapter_id_idx ON history(chapter_id);
CREATE INDEX history_read_at_idx ON history(read_at);

getRecentHistory:
SELECT
    h.id AS history_id,
    h.read_at,
    h.time_read,
    c.id AS chapter_id,
    c.url AS chapter_url,
    c.name AS chapter_name,
    c.chapter_number,
    c.last_page_read,
    m.id AS manga_id,
    m.url AS manga_url,
    m.title AS manga_title,
    m.thumbnail_url AS manga_thumbnail,
    m.is_novel AS manga_is_novel
FROM history h
JOIN chapters c ON h.chapter_id = c.id
JOIN mangas m ON c.manga_id = m.id
ORDER BY h.read_at DESC
LIMIT :limit;

getContinueReading:
SELECT
    m.url AS manga_url,
    m.title AS manga_title,
    m.thumbnail_url AS manga_thumbnail,
    m.author AS manga_author,
    m.artist AS manga_artist,
    m.description AS manga_description,
    m.genres AS manga_genres,
    m.status AS manga_status,
    m.is_novel AS manga_is_novel,
    c.url AS chapter_url,
    c.name AS chapter_name,
    c.chapter_number AS chapter_number,
    c.date_upload AS chapter_date_upload,
    c.last_page_read AS chapter_last_page_read
FROM history h
JOIN chapters c ON h.chapter_id = c.id
JOIN mangas m ON c.manga_id = m.id
ORDER BY h.read_at DESC
LIMIT 1;

upsertHistory:
INSERT OR REPLACE INTO history (
    id, chapter_id, read_at, time_read
) VALUES (
    (SELECT id FROM history WHERE chapter_id = :chapterId),
    :chapterId,
    :readAt,
    :timeRead
);

deleteHistoryByChapterId:
DELETE FROM history
WHERE chapter_id = :chapterId;

clearAllHistory:
DELETE FROM history;
